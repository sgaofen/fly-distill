# Z.ai GLM Coding Plan API keys. Old Max plan: ~2400 prompts/5h, no weekly cap.
# Multiple keys round-robin for higher concurrency.
ZAI_API_KEY=your_zai_key_here
ZAI_API_KEYS=your_zai_key_here,optional_second_key_for_higher_concurrency

# Z.ai endpoint — Anthropic-compatible
ZAI_BASE_URL=https://api.z.ai/api/anthropic
ZAI_MODEL=glm-5.1

# For NCBI E-utilities (PubMed) requests
NCBI_EMAIL=your_email@example.com

# Optional: for tier-2 Opus audit via api.anthropic.com (otherwise GLM self-audits)
# ANTHROPIC_API_KEY=sk-ant-...

# Rate-limiting knobs (defaults shown)
# ZAI_MAX_CONCURRENT=10
# ZAI_RESERVE_SLOTS=2
# ZAI_HARNESS_WEIGHT=3
# ZAI_QUOTA_WAIT_S=300
